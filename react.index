import React, { useState, useEffect, useMemo, useRef } from 'react';
import { 
  Users, 
  BarChart3, 
  Trophy, 
  UserCircle, 
  FileText, 
  AlertCircle, 
  History, 
  Menu, 
  X, 
  LogOut, 
  ChevronRight,
  Send,
  Plus,
  Edit2,
  Bell,
  Clock,
  CheckCircle2,
  UserPlus
} from 'lucide-react';
import { initializeApp } from 'firebase/app';
import { 
  getFirestore, 
  collection, 
  doc, 
  onSnapshot, 
  query, 
  addDoc, 
  updateDoc, 
  serverTimestamp,
  where,
  getDocs,
  orderBy
} from 'firebase/firestore';
import { 
  getAuth, 
  signInWithCustomToken, 
  signInAnonymously, 
  onAuthStateChanged
} from 'firebase/auth';

// --- Firebase Configuration ---
const firebaseConfig = JSON.parse(__firebase_config);
const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);
const appId = typeof __app_id !== 'undefined' ? __app_id : 'siriuslink-log-v2';

// --- Constants ---
const TEAMS = ['山路優チーム', '磯和美優チーム', '西河はるやチーム'];
const ORGANIZATIONS = ['SIRIUSLINK', '西河はるやチーム'];
const POSITIONS = ['アポインター', '自力プレーヤー', 'クローザー'];

// --- Helper Functions ---
const calculateAge = (birthDate) => {
  if (!birthDate) return 0;
  const today = new Date();
  const birth = new Date(birthDate);
  let age = today.getFullYear() - birth.getFullYear();
  const m = today.getMonth() - birth.getMonth();
  if (m < 0 || (m === 0 && today.getDate() < birth.getDate())) age--;
  return age;
};

const getQuarter = (dateStr) => {
  const month = new Date(dateStr).getMonth() + 1;
  if (month >= 1 && month <= 3) return 1;
  if (month >= 4 && month <= 6) return 2;
  if (month >= 7 && month <= 9) return 3;
  return 4;
};

// --- Components ---

export default function App() {
  const [user, setUser] = useState(null);
  const [loading, setLoading] = useState(true);
  const [activePage, setActivePage] = useState('タイムライン');
  const [sidebarOpen, setSidebarOpen] = useState(false);
  const [staffData, setStaffData] = useState([]);
  const [dailyReports, setDailyReports] = useState([]);
  const [negotiationReports, setNegotiationReports] = useState([]);
  const [selectedStaffId, setSelectedStaffId] = useState(null);
  const [loginForm, setLoginForm] = useState({ email: '', password: '' });
  
  const lastNoticeId = useRef(null);

  // Auth Initialization
  useEffect(() => {
    const initAuth = async () => {
      try {
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(auth, __initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }
      } catch (err) {
        console.error("Auth initialization failed:", err);
      }
    };
    initAuth();
    
    const unsubscribe = onAuthStateChanged(auth, (fbUser) => {
      const savedUser = localStorage.getItem('siriuslink_session');
      if (savedUser) {
        setUser(JSON.parse(savedUser));
      }
      setLoading(false);
    });
    
    // Request Notification Permission
    if ("Notification" in window && Notification.permission === "default") {
      Notification.requestPermission();
    }

    return () => unsubscribe();
  }, []);

  // Data Listeners
  useEffect(() => {
    if (!auth.currentUser) return;

    const staffUnsub = onSnapshot(collection(db, 'artifacts', appId, 'public', 'data', 'staff'), (snap) => {
      setStaffData(snap.docs.map(d => ({ id: d.id, ...d.data() })));
    });

    const dailyUnsub = onSnapshot(collection(db, 'artifacts', appId, 'public', 'data', 'daily_reports'), (snap) => {
      setDailyReports(snap.docs.map(d => ({ id: d.id, ...d.data() })));
    });

    const negUnsub = onSnapshot(collection(db, 'artifacts', appId, 'public', 'data', 'negotiation_reports'), (snap) => {
      const data = snap.docs.map(d => ({ id: d.id, ...d.data() }));
      setNegotiationReports(data);

      // Notification Logic
      const newContracts = data.filter(r => (r.result === '契約' || r.result === '完工') && r.timestamp);
      if (newContracts.length > 0) {
        const latest = newContracts.sort((a, b) => b.timestamp?.seconds - a.timestamp?.seconds)[0];
        if (latest.id !== lastNoticeId.current && lastNoticeId.current !== null) {
          if (Notification.permission === "granted") {
            new Notification("SIRIUSLINK.LOG: ご契約おめでとうございます！", {
              body: `${latest.customer}様案件 (${latest.result})\nアポ: ${latest.appointer} / クロ: ${latest.closer}`,
              icon: "https://cdn-icons-png.flaticon.com/512/190/190411.png"
            });
          }
        }
        lastNoticeId.current = latest.id;
      } else if (lastNoticeId.current === null && data.length > 0) {
        // Initial load, don't notify but set ref
        const latest = data.filter(r => r.result === '契約' || r.result === '完工').sort((a, b) => b.timestamp?.seconds - a.timestamp?.seconds)[0];
        if (latest) lastNoticeId.current = latest.id;
      }
    });

    return () => { staffUnsub(); dailyUnsub(); negUnsub(); };
  }, [auth.currentUser]);

  const handleLogin = (e) => {
    e.preventDefault();
    // Default Admin Check
    if (loginForm.email === 'uchi2022.official@gmail.com' && loginForm.password === 'take1234') {
      const adminUser = { id: 'admin-1', name: '管理者', email: loginForm.email, role: '管理者' };
      setUser(adminUser);
      localStorage.setItem('siriuslink_session', JSON.stringify(adminUser));
      return;
    }

    const found = staffData.find(s => s.email === loginForm.email && s.password === loginForm.password && !s.retired);
    if (found) {
      setUser(found);
      localStorage.setItem('siriuslink_session', JSON.stringify(found));
    } else {
      alert('メールアドレスまたはパスワードが正しくありません。');
    }
  };

  const handleLogout = () => {
    setUser(null);
    localStorage.removeItem('siriuslink_session');
  };

  if (loading) return (
    <div className="flex h-screen items-center justify-center bg-[#001f3f]">
      <div className="flex flex-col items-center gap-4">
        <div className="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-white"></div>
        <p className="text-white font-bold tracking-widest">SIRIUSLINK.LOG</p>
      </div>
    </div>
  );

  if (!user) return (
    <div className="flex min-h-screen items-center justify-center bg-slate-100 p-6">
      <div className="w-full max-w-md bg-white rounded-3xl shadow-2xl overflow-hidden">
        <div className="bg-[#001f3f] p-10 text-center">
          <h1 className="text-3xl font-black text-white tracking-tighter">SIRIUSLINK.LOG</h1>
          <p className="text-blue-300 text-xs mt-2 uppercase font-bold tracking-widest">Management System</p>
        </div>
        <form onSubmit={handleLogin} className="p-8 space-y-6">
          <div>
            <label className="block text-xs font-bold text-slate-400 mb-1 uppercase">Email Address</label>
            <input 
              type="email" 
              required
              className="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none transition-all"
              value={loginForm.email}
              onChange={(e) => setLoginForm({...loginForm, email: e.target.value})}
            />
          </div>
          <div>
            <label className="block text-xs font-bold text-slate-400 mb-1 uppercase">Password</label>
            <input 
              type="password" 
              required
              className="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none transition-all"
              value={loginForm.password}
              onChange={(e) => setLoginForm({...loginForm, password: e.target.value})}
            />
          </div>
          <button type="submit" className="w-full bg-[#001f3f] text-white py-4 rounded-xl font-bold shadow-lg hover:bg-slate-800 transition-all transform hover:-translate-y-0.5 active:translate-y-0">
            LOGIN
          </button>
        </form>
      </div>
    </div>
  );

  const menuItems = [
    { name: 'タイムライン', icon: History, role: 'any' },
    { name: '全体営業成績', icon: BarChart3, role: 'any' },
    { name: '営業成績ランキング', icon: Trophy, role: 'any' },
    { name: '個人プロフィール', icon: UserCircle, role: 'any' },
    { name: '日報・商談報告', icon: FileText, role: 'any' },
    { name: 'システムエラー報告', icon: AlertCircle, role: 'any' },
    { name: '履歴', icon: History, role: '管理者' },
    { name: 'スタッフ名簿', icon: Users, role: '管理者' },
  ];

  const filteredMenuItems = menuItems.filter(item => item.role === 'any' || item.role === user.role);

  return (
    <div className="flex h-screen bg-slate-50 text-slate-800">
      {/* Sidebar Desktop */}
      <aside className="hidden md:flex flex-col w-72 bg-[#001f3f] text-white border-r border-white/5">
        <div className="p-8 flex items-center gap-3">
          <div className="w-8 h-8 bg-blue-500 rounded-lg flex items-center justify-center">
            <span className="font-black italic text-white text-xs">SL</span>
          </div>
          <h1 className="text-xl font-black italic tracking-tighter">SIRIUSLINK.LOG</h1>
        </div>
        <nav className="flex-1 px-4 space-y-1 overflow-y-auto">
          {filteredMenuItems.map((item) => (
            <button
              key={item.name}
              onClick={() => { setActivePage(item.name); setSelectedStaffId(null); }}
              className={`flex items-center w-full px-4 py-3.5 text-sm font-bold rounded-xl transition-all ${activePage === item.name ? 'bg-blue-600 shadow-lg shadow-blue-600/30' : 'text-slate-400 hover:bg-white/5 hover:text-white'}`}
            >
              <item.icon className={`mr-3 h-5 w-5 ${activePage === item.name ? 'text-white' : 'text-slate-500'}`} />
              {item.name}
            </button>
          ))}
        </nav>
        <div className="p-6 border-t border-white/5 bg-[#001933]">
          <button onClick={handleLogout} className="flex items-center w-full px-4 py-3 text-xs font-bold text-red-400 hover:text-red-300 transition-colors">
            <LogOut className="mr-3 h-4 w-4" />
            LOGOUT
          </button>
        </div>
      </aside>

      {/* Main Content */}
      <div className="flex-1 flex flex-col min-w-0 overflow-hidden">
        {/* Header */}
        <header className="h-20 bg-white border-b border-slate-200 flex items-center justify-between px-6 md:px-10 shrink-0">
          <div className="flex items-center gap-4">
            <button className="md:hidden" onClick={() => setSidebarOpen(true)}>
              <Menu className="h-6 w-6 text-slate-600" />
            </button>
            <h2 className="text-xl font-black text-slate-800 tracking-tight">{activePage}</h2>
          </div>
          <div className="flex items-center gap-4">
            <div className="text-right hidden sm:block">
              <p className="text-sm font-black text-slate-800">{user.name}</p>
              <p className="text-[10px] font-bold text-blue-500 uppercase tracking-widest">{user.role}</p>
            </div>
            <div className="h-10 w-10 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center overflow-hidden">
              {user.photoUrl ? <img src={user.photoUrl} alt="" className="w-full h-full object-cover" /> : <UserCircle className="h-6 w-6 text-slate-400" />}
            </div>
          </div>
        </header>

        {/* Dynamic Content */}
        <main className="flex-1 overflow-y-auto p-6 md:p-10">
          <div className="max-w-7xl mx-auto">
            {activePage === 'タイムライン' && <Timeline reports={negotiationReports} />}
            {activePage === '全体営業成績' && <OverallStats daily={dailyReports} neg={negotiationReports} staff={staffData} goToProfile={(id) => { setSelectedStaffId(id); setActivePage('個人プロフィール'); }} />}
            {activePage === '営業成績ランキング' && <Ranking daily={dailyReports} neg={negotiationReports} staff={staffData} goToProfile={(id) => { setSelectedStaffId(id); setActivePage('個人プロフィール'); }} />}
            {activePage === '個人プロフィール' && <Profile staffId={selectedStaffId || user.id} currentUser={user} staffData={staffData} daily={dailyReports} neg={negotiationReports} />}
            {activePage === '日報・商談報告' && <ReportInput user={user} staff={staffData} />}
            {activePage === 'システムエラー報告' && <ErrorReport />}
            {activePage === '履歴' && <AdminHistory daily={dailyReports} />}
            {activePage === 'スタッフ名簿' && <StaffList staff={staffData} />}
          </div>
        </main>
      </div>

      {/* Mobile Drawer */}
      {sidebarOpen && (
        <div className="fixed inset-0 z-50 md:hidden flex">
          <div className="absolute inset-0 bg-black/60" onClick={() => setSidebarOpen(false)}></div>
          <aside className="relative w-72 bg-[#001f3f] h-full flex flex-col animate-in slide-in-from-left duration-300">
            <div className="p-8 flex items-center justify-between">
              <h1 className="text-xl font-black italic text-white tracking-tighter">SIRIUSLINK.LOG</h1>
              <X className="h-6 w-6 text-white" onClick={() => setSidebarOpen(false)} />
            </div>
            <nav className="flex-1 px-4 space-y-1">
              {filteredMenuItems.map((item) => (
                <button
                  key={item.name}
                  onClick={() => { setActivePage(item.name); setSidebarOpen(false); setSelectedStaffId(null); }}
                  className={`flex items-center w-full px-4 py-4 text-sm font-bold rounded-xl ${activePage === item.name ? 'bg-blue-600 text-white' : 'text-slate-400'}`}
                >
                  <item.icon className="mr-3 h-5 w-5" />
                  {item.name}
                </button>
              ))}
            </nav>
          </aside>
        </div>
      )}
    </div>
  );
}

// --- Page Components ---

function Timeline({ reports }) {
  const latest = useMemo(() => {
    return reports
      .filter(r => r.result === '契約' || r.result === '完工')
      .sort((a, b) => new Date(b.date) - new Date(a.date))
      .slice(0, 10);
  }, [reports]);

  return (
    <div className="space-y-6">
      <div className="flex items-center gap-3 mb-8">
        <Bell className="h-6 w-6 text-blue-500" />
        <h3 className="text-2xl font-black text-[#001f3f]">リアルタイム成約フィード</h3>
      </div>
      {latest.length === 0 ? (
        <div className="bg-white rounded-3xl p-20 text-center border-2 border-dashed border-slate-200">
          <Clock className="h-12 w-12 text-slate-300 mx-auto mb-4" />
          <p className="text-slate-400 font-bold">まだ契約情報がありません</p>
        </div>
      ) : (
        <div className="grid gap-6">
          {latest.map((item) => (
            <div key={item.id} className="bg-white rounded-3xl p-8 shadow-sm border border-slate-100 relative overflow-hidden group hover:shadow-xl hover:border-blue-200 transition-all">
              <div className="absolute top-0 right-0 p-6">
                <div className={`px-4 py-1 rounded-full text-[10px] font-black uppercase tracking-widest ${item.result === '完工' ? 'bg-green-100 text-green-700' : 'bg-blue-100 text-blue-700'}`}>
                  {item.result}
                </div>
              </div>
              <div className="mb-6">
                <h4 className="text-2xl font-black text-blue-600 mb-1">ご契約おめでとうございます！</h4>
                <p className="text-slate-400 font-bold text-sm uppercase tracking-widest">{new Date(item.date).toLocaleDateString('ja-JP', { month: 'long', day: 'numeric' })}</p>
              </div>
              <div className="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
                <div className="bg-slate-50 p-4 rounded-2xl">
                  <p className="text-[10px] font-bold text-slate-400 uppercase mb-1">Appointer</p>
                  <p className="font-black text-slate-800">{item.appointer}</p>
                </div>
                <div className="bg-slate-50 p-4 rounded-2xl">
                  <p className="text-[10px] font-bold text-slate-400 uppercase mb-1">Closer</p>
                  <p className="font-black text-slate-800">{item.closer}</p>
                </div>
                <div className="bg-slate-50 p-4 rounded-2xl">
                  <p className="text-[10px] font-bold text-slate-400 uppercase mb-1">Customer</p>
                  <p className="font-black text-slate-800">{item.customer} 様案件</p>
                </div>
              </div>
              <div className="space-y-4">
                <div className="bg-blue-50/50 p-5 rounded-2xl border border-blue-100">
                  <p className="text-[10px] font-black text-blue-600 uppercase mb-2">上長から{item.appointer}さんへのコメント</p>
                  <p className="text-sm text-slate-600 leading-relaxed italic">"{item.appointerComment || "素晴らしいアポイントでした。この調子で頑張りましょう！"}"</p>
                </div>
                {item.closerComment && (
                  <div className="bg-purple-50/50 p-5 rounded-2xl border border-purple-100">
                    <p className="text-[10px] font-black text-purple-600 uppercase mb-2">上長から{item.closer}さんへのコメント</p>
                    <p className="text-sm text-slate-600 leading-relaxed italic">"{item.closerComment}"</p>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  );
}

function OverallStats({ daily, neg, staff, goToProfile }) {
  const [filter, setFilter] = useState({ type: 'month', value: new Date().getMonth() + 1 });

  const filtered = useMemo(() => {
    return {
      daily: daily.filter(d => {
        const date = new Date(d.date);
        return filter.type === 'month' ? (date.getMonth() + 1 === filter.value) : (getQuarter(d.date) === filter.value);
      }),
      neg: neg.filter(n => {
        const date = new Date(n.date);
        return filter.type === 'month' ? (date.getMonth() + 1 === filter.value) : (getQuarter(n.date) === filter.value);
      })
    };
  }, [daily, neg, filter]);

  const stats = useMemo(() => {
    const s = {
      sales: 0, finished: 0, attendance: 0, pings: 0, responses: 0, inkicks: 0, doorkicks: 0, 
      exclusions: 0, up: 0, appo: 0, negs: 0, contracts: 0, appoContracts: 0, closerContracts: 0,
      appoFinished: 0, closerFinished: 0
    };
    filtered.daily.forEach(d => {
      s.attendance += d.workType === '平日対応' ? 0.3 : 1.0;
      s.pings += Number(d.pings || 0);
      s.responses += Number(d.responses || 0);
      s.inkicks += Number(d.inKicks || 0);
      s.doorkicks += Number(d.doorKicks || 0);
      s.exclusions += Number(d.exclusions || 0);
      s.up += Number(d.upCount || 0);
      s.appo += Number(d.appoCount || 0);
    });
    filtered.neg.forEach(n => {
      s.negs++;
      if (n.result === '契約' || n.result === '完工') {
        s.contracts++;
        if (n.result === '完工') {
          s.finished++;
          s.sales += 100; // Placeholder sales logic
        }
      }
    });
    return s;
  }, [filtered]);

  // staff mapping
  const staffList = useMemo(() => {
    return staff.filter(s => !s.retired).map(s => {
      const pDaily = filtered.daily.filter(d => d.appointer === s.name);
      const pAppoNeg = filtered.neg.filter(n => n.appointer === s.name);
      const pCloserNeg = filtered.neg.filter(n => n.closer === s.name);
      return {
        ...s,
        att: pDaily.reduce((a, c) => a + (c.workType === '平日対応' ? 0.3 : 1), 0),
        pings: pDaily.reduce((a, c) => a + Number(c.pings || 0), 0),
        responses: pDaily.reduce((a, c) => a + Number(c.responses || 0), 0),
        appos: pDaily.reduce((a, c) => a + Number(c.appoCount || 0), 0),
        negs: pAppoNeg.length,
        appoFin: pAppoNeg.filter(n => n.result === '完工').length,
        closerFin: pCloserNeg.filter(n => n.result === '完工').length
      };
    }).sort((a, b) => a.name.localeCompare(b.name, 'ja'));
  }, [staff, filtered]);

  const pingFinRate = Math.round((stats.finished / (stats.pings || 1)) * 100);
  const avgPings = Math.round(stats.pings / (stats.attendance || 1));
  const cancelRate = Math.round(((stats.contracts - stats.finished) / (stats.contracts || 1)) * 100);

  return (
    <div className="space-y-10 pb-20">
      <div className="flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
        <h3 className="text-2xl font-black text-[#001f3f]">
          2024年{filter.type === 'month' ? `${filter.value}月` : `第${filter.value}クール`} 全体営業成績
        </h3>
        <div className="flex bg-white rounded-2xl p-1 shadow-sm border border-slate-200">
          <select className="bg-transparent text-sm font-bold px-4 py-2 outline-none" value={filter.type} onChange={(e) => setFilter({...filter, type: e.target.value})}>
            <option value="month">月別</option>
            <option value="quarter">クール別</option>
          </select>
          <div className="w-px bg-slate-200 my-2"></div>
          <select className="bg-transparent text-sm font-bold px-4 py-2 outline-none" value={filter.value} onChange={(e) => setFilter({...filter, value: Number(e.target.value)})}>
            {filter.type === 'month' 
              ? [...Array(12)].map((_, i) => <option key={i+1} value={i+1}>{i+1}月</option>)
              : [1,2,3,4].map(q => <option key={q} value={q}>第{q}クール</option>)
            }
          </select>
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div className="bg-[#001f3f] rounded-3xl p-10 text-white shadow-2xl relative overflow-hidden group">
          <div className="absolute top-0 right-0 p-8 opacity-10 group-hover:scale-110 transition-transform">
            <BarChart3 className="h-32 w-32" />
          </div>
          <p className="text-blue-300 text-xs font-black uppercase tracking-widest mb-2">Total Sales</p>
          <div className="flex items-baseline gap-2">
            <span className="text-6xl font-black">{stats.sales.toLocaleString()}</span>
            <span className="text-2xl font-bold opacity-60">万円</span>
          </div>
        </div>
        <div className="bg-blue-600 rounded-3xl p-10 text-white shadow-2xl relative overflow-hidden group">
          <div className="absolute top-0 right-0 p-8 opacity-10 group-hover:scale-110 transition-transform">
            <CheckCircle2 className="h-32 w-32" />
          </div>
          <p className="text-blue-100 text-xs font-black uppercase tracking-widest mb-2">Total Finished</p>
          <div className="flex items-baseline gap-2">
            <span className="text-6xl font-black">{stats.finished}</span>
            <span className="text-2xl font-bold opacity-60">件</span>
          </div>
        </div>
      </div>

      <div className="grid grid-cols-2 md:grid-cols-4 xl:grid-cols-7 gap-4">
        {[
          { label: '総出勤数', val: stats.attendance.toFixed(1), unit: '日' },
          { label: 'ピン数', val: stats.pings, unit: '回' },
          { label: '対応数', val: stats.responses, unit: '回' },
          { label: 'インキック', val: stats.inkicks, unit: '回' },
          { label: 'ドアキック', val: stats.doorkicks, unit: '回' },
          { label: 'アポ数', val: stats.appo, unit: '件' },
          { label: '商談数', val: stats.negs, unit: '件' },
        ].map((item, i) => (
          <div key={i} className="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm text-center">
            <p className="text-[10px] font-black text-slate-400 uppercase mb-1">{item.label}</p>
            <p className="text-xl font-black text-slate-800">{item.val}<span className="text-xs font-bold text-slate-400 ml-1">{item.unit}</span></p>
          </div>
        ))}
      </div>

      <div className="grid md:grid-cols-3 gap-6">
        <div className="bg-white p-10 rounded-3xl shadow-sm border border-slate-100 text-center">
          <p className="text-xs font-black text-slate-400 uppercase mb-2">ピンポン完工率</p>
          <p className="text-5xl font-black text-blue-600">{pingFinRate}%</p>
        </div>
        <div className="bg-white p-10 rounded-3xl shadow-sm border border-slate-100 text-center">
          <p className="text-xs font-black text-slate-400 uppercase mb-2">1日平均ピン数</p>
          <p className="text-5xl font-black text-blue-600">{avgPings}<span className="text-lg font-bold ml-1">件</span></p>
        </div>
        <div className="bg-white p-10 rounded-3xl shadow-sm border border-slate-100 text-center relative overflow-hidden">
          <p className="text-xs font-black text-slate-400 uppercase mb-2">キャンセル率</p>
          <p className={`text-5xl font-black ${cancelRate > 25 ? 'text-red-500 animate-pulse' : 'text-slate-800'}`}>{cancelRate}%</p>
          <p className="text-[10px] font-bold text-red-400 mt-4 uppercase">Target: Below 25%</p>
        </div>
      </div>

      <div className="bg-white rounded-3xl shadow-sm border border-slate-100 overflow-hidden">
        <div className="p-8 border-b border-slate-50">
          <h4 className="font-black text-[#001f3f]">営業スタッフ別成績表一覧</h4>
        </div>
        <div className="overflow-x-auto">
          <table className="w-full text-left">
            <thead className="bg-slate-50">
              <tr>
                <th className="px-8 py-4 text-[10px] font-black text-slate-400 uppercase">スタッフ</th>
                <th className="px-4 py-4 text-[10px] font-black text-slate-400 uppercase">出勤</th>
                <th className="px-4 py-4 text-[10px] font-black text-slate-400 uppercase">ピン</th>
                <th className="px-4 py-4 text-[10px] font-black text-slate-400 uppercase">アポ</th>
                <th className="px-4 py-4 text-[10px] font-black text-slate-400 uppercase">アポ完</th>
                <th className="px-4 py-4 text-[10px] font-black text-slate-400 uppercase">クロ完</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-slate-50">
              {staffList.map(s => (
                <tr key={s.id} onClick={() => goToProfile(s.id)} className="hover:bg-blue-50/50 cursor-pointer transition-colors group">
                  <td className="px-8 py-5">
                    <div className="flex items-center gap-4">
                      <div className="w-10 h-10 rounded-full bg-slate-200 overflow-hidden border-2 border-white shadow-sm group-hover:border-blue-300">
                        {s.photoUrl ? <img src={s.photoUrl} alt="" className="w-full h-full object-cover" /> : <UserCircle className="w-full h-full text-slate-400 p-1" />}
                      </div>
                      <span className="font-black text-slate-700">{s.name}</span>
                    </div>
                  </td>
                  <td className="px-4 py-5 font-bold">{s.att.toFixed(1)}</td>
                  <td className="px-4 py-5 font-bold">{s.pings}</td>
                  <td className="px-4 py-5 font-black text-blue-600">{s.appos}</td>
                  <td className="px-4 py-5 font-black text-green-600">{s.appoFin}</td>
                  <td className="px-4 py-5 font-black text-purple-600">{s.closerFin}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
}

function Ranking({ daily, neg, staff, goToProfile }) {
  const [filter, setFilter] = useState({ type: 'month', value: new Date().getMonth() + 1 });
  const [category, setCategory] = useState('appoint'); // appoint / closing
  const [metric, setMetric] = useState('完工数');

  const filtered = useMemo(() => {
    return {
      daily: daily.filter(d => filter.type === 'month' ? (new Date(d.date).getMonth() + 1 === filter.value) : (getQuarter(d.date) === filter.value)),
      neg: neg.filter(n => filter.type === 'month' ? (new Date(n.date).getMonth() + 1 === filter.value) : (getQuarter(n.date) === filter.value))
    };
  }, [daily, neg, filter]);

  const rankings = useMemo(() => {
    const list = staff.filter(s => !s.retired).map(s => {
      const pDaily = filtered.daily.filter(d => d.appointer === s.name);
      const pAppoNeg = filtered.neg.filter(n => n.appointer === s.name);
      const pCloserNeg = filtered.neg.filter(n => n.closer === s.name);
      
      const stats = {
        name: s.name, id: s.id, photo: s.photoUrl,
        pings: pDaily.reduce((a, c) => a + Number(c.pings || 0), 0),
        appos: pDaily.reduce((a, c) => a + Number(c.appoCount || 0), 0),
        appoNegs: pAppoNeg.length,
        appoFin: pAppoNeg.filter(n => n.result === '完工').length,
        closerNegs: pCloserNeg.length,
        closerFin: pCloserNeg.filter(n => n.result === '完工').length,
        closerContracts: pCloserNeg.filter(n => n.result === '契約' || n.result === '完工').length
      };

      stats.pingFinRate = Math.round((stats.appoFin / (stats.pings || 1)) * 100);
      stats.negFinRate = Math.round((stats.closerFin / (stats.closerNegs || 1)) * 100);
      stats.cancelRate = Math.round(((stats.closerContracts - stats.closerFin) / (stats.closerContracts || 1)) * 100);

      return stats;
    });

    let sortKey = '';
    let isAsc = false;
    if (category === 'appoint') {
      if (metric === '完工数') sortKey = 'appoFin';
      if (metric === '商談数') sortKey = 'appoNegs';
      if (metric === 'アポ数') sortKey = 'appos';
      if (metric === 'ピンポン数') sortKey = 'pings';
      if (metric === 'ピンポン完工率') sortKey = 'pingFinRate';
    } else {
      if (metric === '完工数') sortKey = 'closerFin';
      if (metric === '商談完工率') sortKey = 'negFinRate';
      if (metric === 'キャンセル率') { sortKey = 'cancelRate'; isAsc = true; }
    }

    return list.sort((a, b) => isAsc ? a[sortKey] - b[sortKey] : b[sortKey] - a[sortKey]);
  }, [staff, filtered, category, metric]);

  const metrics = category === 'appoint' 
    ? ['完工数', '商談数', 'アポ数', 'ピンポン数', 'ピンポン完工率'] 
    : ['完工数', '商談完工率', 'キャンセル率'];

  return (
    <div className="space-y-8">
      <div className="flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
        <h3 className="text-2xl font-black text-[#001f3f]">
          ランキング: {category === 'appoint' ? 'アポイント' : 'クロージング'} {metric}
        </h3>
        <div className="flex bg-white rounded-2xl p-1 shadow-sm border border-slate-200">
          <select className="bg-transparent text-sm font-bold px-4 py-2 outline-none" value={filter.type} onChange={(e) => setFilter({...filter, type: e.target.value})}>
            <option value="month">月別</option>
            <option value="quarter">クール別</option>
          </select>
          <select className="bg-transparent text-sm font-bold px-4 py-2 outline-none" value={filter.value} onChange={(e) => setFilter({...filter, value: Number(e.target.value)})}>
             {filter.type === 'month' 
              ? [...Array(12)].map((_, i) => <option key={i+1} value={i+1}>{i+1}月</option>)
              : [1,2,3,4].map(q => <option key={q} value={q}>第{q}クール</option>)
            }
          </select>
        </div>
      </div>

      <div className="bg-white rounded-3xl p-4 shadow-sm border border-slate-100">
        <div className="flex p-2 bg-slate-50 rounded-2xl mb-6">
          <button onClick={() => {setCategory('appoint'); setMetric('完工数');}} className={`flex-1 py-3 text-sm font-black rounded-xl transition-all ${category === 'appoint' ? 'bg-[#001f3f] text-white shadow-lg' : 'text-slate-400'}`}>アポイント</button>
          <button onClick={() => {setCategory('closing'); setMetric('完工数');}} className={`flex-1 py-3 text-sm font-black rounded-xl transition-all ${category === 'closing' ? 'bg-[#001f3f] text-white shadow-lg' : 'text-slate-400'}`}>クロージング</button>
        </div>
        <div className="flex flex-wrap gap-2 px-2 mb-6">
          {metrics.map(m => (
            <button key={m} onClick={() => setMetric(m)} className={`px-4 py-2 text-xs font-bold rounded-full border transition-all ${metric === m ? 'bg-blue-600 border-blue-600 text-white' : 'border-slate-200 text-slate-500 hover:border-blue-400'}`}>
              {m}
            </button>
          ))}
        </div>

        <div className="grid gap-3 p-2">
          {rankings.map((s, idx) => (
            <div key={s.id} onClick={() => goToProfile(s.id)} className="flex items-center bg-slate-50/50 p-4 rounded-2xl border border-slate-100 hover:border-blue-300 hover:bg-white transition-all cursor-pointer group">
              <div className="w-10 text-center font-black text-slate-300 group-hover:text-blue-500 text-xl">{idx + 1}</div>
              <div className="w-12 h-12 rounded-full bg-slate-200 mx-4 overflow-hidden border-2 border-white shadow-sm">
                {s.photo ? <img src={s.photo} alt="" className="w-full h-full object-cover" /> : <UserCircle className="w-full h-full text-slate-400 p-1" />}
              </div>
              <div className="flex-1">
                <p className="font-black text-slate-800">{s.name}</p>
                <p className="text-[10px] text-slate-400 uppercase font-bold tracking-widest">{metric === 'キャンセル率' ? 'Accuracy Ranking' : 'Sales Power'}</p>
              </div>
              <div className="text-right">
                <span className="text-2xl font-black text-[#001f3f]">
                  {metric === '完工数' && (category === 'appoint' ? s.appoFin : s.closerFin)}
                  {metric === '商談数' && s.appoNegs}
                  {metric === 'アポ数' && s.appos}
                  {metric === 'ピンポン数' && s.pings}
                  {metric === 'ピンポン完工率' && `${s.pingFinRate}%`}
                  {metric === '商談完工率' && `${s.negFinRate}%`}
                  {metric === 'キャンセル率' && `${s.cancelRate}%`}
                </span>
                <span className="text-xs font-bold text-slate-400 ml-1">
                  {(metric === '完工数' || metric === '商談数' || metric === 'アポ数') ? '件' : (metric === 'ピンポン数' ? '回' : '')}
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}

function Profile({ staffId, currentUser, staffData, daily, neg }) {
  const staff = staffData.find(s => s.id === staffId) || currentUser;
  const isSelf = currentUser.id === staffId || (!staffId && currentUser);
  const isAdmin = currentUser.role === '管理者';

  const [dateRange, setDateRange] = useState({ 
    start: new Date(new Date().setDate(1)).toISOString().split('T')[0], 
    end: new Date().toISOString().split('T')[0] 
  });
  const [editMode, setEditMode] = useState(false);
  const [bio, setBio] = useState(staff.bio || '');
  const [photoUrl, setPhotoUrl] = useState(staff.photoUrl || '');

  const stats = useMemo(() => {
    const pDaily = daily.filter(d => d.appointer === staff.name && d.date >= dateRange.start && d.date <= dateRange.end);
    const pAppoNeg = neg.filter(n => n.appointer === staff.name && n.date >= dateRange.start && n.date <= dateRange.end);
    const pCloserNeg = neg.filter(n => n.closer === staff.name && n.date >= dateRange.start && n.date <= dateRange.end);

    const s = {
      att: pDaily.reduce((a, c) => a + (c.workType === '平日対応' ? 0.3 : 1), 0),
      pings: pDaily.reduce((a, c) => a + Number(c.pings || 0), 0),
      res: pDaily.reduce((a, c) => a + Number(c.responses || 0), 0),
      inkicks: pDaily.reduce((a, c) => a + Number(c.inKicks || 0), 0),
      doorkicks: pDaily.reduce((a, c) => a + Number(c.doorKicks || 0), 0),
      ex: pDaily.reduce((a, c) => a + Number(c.exclusions || 0), 0),
      up: pDaily.reduce((a, c) => a + Number(c.upCount || 0), 0),
      appo: pDaily.reduce((a, c) => a + Number(c.appoCount || 0), 0),
      appoNegs: pAppoNeg.length,
      appoContracts: pAppoNeg.filter(n => n.result === '契約' || n.result === '完工').length,
      appoFin: pAppoNeg.filter(n => n.result === '完工').length,
      closerNegs: pCloserNeg.length,
      closerContracts: pCloserNeg.filter(n => n.result === '契約' || n.result === '完工').length,
      closerFin: pCloserNeg.filter(n => n.result === '完工').length,
    };

    s.pingFinRate = Math.round((s.appoFin / (s.pings || 1)) * 100);
    s.avgPings = Math.round(s.pings / (s.att || 1));
    s.closerFinRate = Math.round((s.closerFin / (s.closerNegs || 1)) * 100);
    s.cancelRate = Math.round(((s.closerContracts - s.closerFin) / (s.closerContracts || 1)) * 100);

    return s;
  }, [staff, daily, neg, dateRange]);

  const saveProfile = async () => {
    try {
      await updateDoc(doc(db, 'artifacts', appId, 'public', 'data', 'staff', staff.id), { bio, photoUrl });
      setEditMode(false);
    } catch (e) { alert('保存に失敗しました'); }
  };

  return (
    <div className="space-y-10 pb-20">
      <div className="flex justify-between items-center">
        <h3 className="text-2xl font-black text-[#001f3f]">個人プロフィール</h3>
        {isSelf && (
          <button onClick={() => editMode ? saveProfile() : setEditMode(true)} className={`px-6 py-2 rounded-xl font-bold text-sm shadow-sm transition-all ${editMode ? 'bg-green-600 text-white' : 'bg-white text-blue-600 border border-blue-100 hover:bg-blue-50'}`}>
            {editMode ? '変更内容を保存' : 'プロフィールを編集'}
          </button>
        )}
      </div>

      <div className="grid lg:grid-cols-3 gap-10">
        <div className="lg:col-span-1 space-y-6">
          <div className="bg-white rounded-3xl overflow-hidden shadow-sm border border-slate-100">
            <div className="h-24 bg-[#001f3f]"></div>
            <div className="px-8 pb-10 text-center -mt-12">
              <div className="w-24 h-24 rounded-3xl bg-slate-100 border-4 border-white shadow-lg mx-auto overflow-hidden">
                {staff.photoUrl ? <img src={staff.photoUrl} alt="" className="w-full h-full object-cover" /> : <UserCircle className="w-full h-full text-slate-300 p-2" />}
              </div>
              <div className="mt-6">
                <h4 className="text-xl font-black text-slate-800">{staff.name}</h4>
                <p className="text-xs font-bold text-blue-500 uppercase tracking-widest mt-1">{staff.position}</p>
              </div>
              <div className="mt-8 bg-slate-50 p-4 rounded-2xl text-left italic text-sm text-slate-500 relative">
                {editMode ? (
                  <input maxLength={15} className="w-full bg-white border p-2 rounded text-xs" value={bio} onChange={e => setBio(e.target.value)} placeholder="一言 (15文字以内)" />
                ) : (
                  `"${staff.bio || '目標に向かって邁進します！'}"`
                )}
              </div>
              <div className="mt-10 space-y-4 text-left border-t border-slate-50 pt-8">
                <div className="flex justify-between items-center"><span className="text-[10px] font-black text-slate-400 uppercase">Team</span><span className="text-sm font-bold">{staff.team}</span></div>
                <div className="flex justify-between items-center"><span className="text-[10px] font-black text-slate-400 uppercase">Age</span><span className="text-sm font-bold">{calculateAge(staff.birthDate)}歳</span></div>
                <div className="flex justify-between items-center"><span className="text-[10px] font-black text-slate-400 uppercase">Gender</span><span className="text-sm font-bold">{staff.gender}</span></div>
              </div>
            </div>
          </div>
          {editMode && (
            <div className="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm">
              <label className="block text-[10px] font-black text-slate-400 uppercase mb-2">プロフィール画像 URL</label>
              <input className="w-full p-3 bg-slate-50 border rounded-xl text-xs outline-none" value={photoUrl} onChange={e => setPhotoUrl(e.target.value)} />
            </div>
          )}
        </div>

        <div className="lg:col-span-2 space-y-10">
          <div className="bg-white rounded-3xl p-10 shadow-sm border border-slate-100">
            <div className="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-10">
              <h4 className="text-lg font-black text-[#001f3f] underline decoration-blue-500 underline-offset-8 decoration-4">{staff.name}さんの営業統計</h4>
              <div className="flex items-center gap-3">
                <input type="date" className="p-2 border rounded-xl text-xs font-bold" value={dateRange.start} onChange={e => setDateRange({...dateRange, start: e.target.value})} />
                <span className="text-slate-300">→</span>
                <input type="date" className="p-2 border rounded-xl text-xs font-bold" value={dateRange.end} onChange={e => setDateRange({...dateRange, end: e.target.value})} />
              </div>
            </div>

            <div className="space-y-12">
              <section>
                <div className="flex items-center gap-2 mb-6">
                  <div className="w-1 h-5 bg-blue-600 rounded-full"></div>
                  <h5 className="font-black text-sm uppercase tracking-widest text-blue-600">Appoint Performance</h5>
                </div>
                <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
                  <div className="bg-slate-50 p-6 rounded-2xl text-center">
                    <p className="text-[10px] font-black text-slate-400 uppercase mb-1">ピン完率</p>
                    <p className="text-2xl font-black text-slate-800">{stats.pingFinRate}%</p>
                  </div>
                  <div className="bg-slate-50 p-6 rounded-2xl text-center">
                    <p className="text-[10px] font-black text-slate-400 uppercase mb-1">Avg Pings</p>
                    <p className="text-2xl font-black text-slate-800">{stats.avgPings}<span className="text-xs font-bold ml-1">回</span></p>
                  </div>
                  <div className="bg-blue-600 p-6 rounded-2xl text-center text-white col-span-2 shadow-lg shadow-blue-600/20">
                    <p className="text-[10px] font-black text-blue-100 uppercase mb-1">アポ完工数</p>
                    <p className="text-3xl font-black">{stats.appoFin}<span className="text-sm font-bold ml-1">件</span></p>
                  </div>
                </div>
                <div className="grid grid-cols-2 md:grid-cols-4 gap-y-4 text-[10px] font-bold text-slate-500 uppercase">
                  <div className="flex justify-between border-b pb-2 mx-2"><span>出勤数</span><span className="text-slate-800">{stats.att.toFixed(1)}日</span></div>
                  <div className="flex justify-between border-b pb-2 mx-2"><span>ピン数</span><span className="text-slate-800">{stats.pings}回</span></div>
                  <div className="flex justify-between border-b pb-2 mx-2"><span>アポ数</span><span className="text-slate-800">{stats.appo}件</span></div>
                  <div className="flex justify-between border-b pb-2 mx-2"><span>商談数</span><span className="text-slate-800">{stats.appoNegs}件</span></div>
                </div>
              </section>

              <section>
                <div className="flex items-center gap-2 mb-6">
                  <div className="w-1 h-5 bg-purple-600 rounded-full"></div>
                  <h5 className="font-black text-sm uppercase tracking-widest text-purple-600">Closing Performance</h5>
                </div>
                <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
                  <div className="bg-purple-600 p-6 rounded-2xl text-center text-white col-span-2 shadow-lg shadow-purple-600/20">
                    <p className="text-[10px] font-black text-purple-100 uppercase mb-1">クロ完工数</p>
                    <p className="text-3xl font-black">{stats.closerFin}<span className="text-sm font-bold ml-1">件</span></p>
                  </div>
                  <div className="bg-slate-50 p-6 rounded-2xl text-center">
                    <p className="text-[10px] font-black text-slate-400 uppercase mb-1">商談完率</p>
                    <p className="text-2xl font-black text-slate-800">{stats.closerFinRate}%</p>
                  </div>
                  <div className="bg-slate-50 p-6 rounded-2xl text-center">
                    <p className="text-[10px] font-black text-slate-400 uppercase mb-1">Cancel Rate</p>
                    <p className="text-2xl font-black text-slate-800">{stats.cancelRate}%</p>
                  </div>
                </div>
              </section>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}

function ReportInput({ user, staff }) {
  const [tab, setTab] = useState('appoint');
  const [loading, setLoading] = useState(false);
  const isAdmin = user.role === '管理者';

  const [appoForm, setAppoForm] = useState({
    date: new Date().toISOString().split('T')[0],
    workType: '通常対応', pings: '', res: '', inkicks: '', doorkicks: '', ex: '', up: '', appo: ''
  });

  const [closeForm, setCloseForm] = useState({
    date: new Date().toISOString().split('T')[0],
    appointer: '', closer: user.name, customer: '', result: '失注', appoComment: '', closerComment: ''
  });

  const submitAppo = async (e) => {
    e.preventDefault();
    setLoading(true);
    try {
      await addDoc(collection(db, 'artifacts', appId, 'public', 'data', 'daily_reports'), {
        ...appoForm, appointer: user.name, timestamp: serverTimestamp()
      });
      alert('アポイント報告を送信しました。');
      setAppoForm({...appoForm, pings: '', res: '', inkicks: '', doorkicks: '', ex: '', up: '', appo: ''});
    } catch (e) { alert('送信に失敗しました'); }
    setLoading(false);
  };

  const submitClose = async (e) => {
    e.preventDefault();
    if (closeForm.appoComment.length < 50) return alert('アポインターへのコメントは50文字以上必要です');
    setLoading(true);
    try {
      await addDoc(collection(db, 'artifacts', appId, 'public', 'data', 'negotiation_reports'), {
        ...closeForm, timestamp: serverTimestamp()
      });
      alert('商談報告を送信しました。');
      setCloseForm({...closeForm, customer: '', appoComment: '', closerComment: ''});
    } catch (e) { alert('送信に失敗しました'); }
    setLoading(false);
  };

  return (
    <div className="max-w-3xl mx-auto space-y-10 pb-20">
      <div className="flex p-2 bg-white rounded-3xl shadow-sm border border-slate-100">
        <button onClick={() => setTab('appoint')} className={`flex-1 py-4 text-sm font-black rounded-2xl transition-all ${tab === 'appoint' ? 'bg-[#001f3f] text-white shadow-xl' : 'text-slate-400 hover:text-slate-600'}`}>アポイント報告</button>
        {isAdmin && (
          <button onClick={() => setTab('closing')} className={`flex-1 py-4 text-sm font-black rounded-2xl transition-all ${tab === 'closing' ? 'bg-[#001f3f] text-white shadow-xl' : 'text-slate-400 hover:text-slate-600'}`}>クロージング報告</button>
        )}
      </div>

      <div className="bg-white rounded-[40px] p-10 shadow-2xl border border-slate-100">
        {tab === 'appoint' ? (
          <form onSubmit={submitAppo} className="space-y-8">
            <div className="grid md:grid-cols-2 gap-8">
              <div>
                <label className="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2 block">アポインター</label>
                <div className="p-4 bg-slate-50 rounded-2xl border border-slate-100 font-bold text-slate-400">{user.name}</div>
              </div>
              <div>
                <label className="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2 block">報告日</label>
                <input type="date" required className="w-full p-4 bg-slate-50 rounded-2xl border border-slate-100 font-bold outline-none focus:ring-2 focus:ring-blue-500" value={appoForm.date} onChange={e => setAppoForm({...appoForm, date: e.target.value})} />
              </div>
            </div>
            <div>
              <label className="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2 block">対応区分</label>
              <div className="flex gap-4">
                {['通常対応', '平日対応'].map(t => (
                  <button key={t} type="button" onClick={() => setAppoForm({...appoForm, workType: t})} className={`flex-1 py-4 rounded-2xl font-black text-sm transition-all border-2 ${appoForm.workType === t ? 'border-blue-600 bg-blue-50 text-blue-600' : 'border-slate-100 bg-slate-50 text-slate-400'}`}>{t}</button>
                ))}
              </div>
            </div>
            <div className="grid grid-cols-2 md:grid-cols-4 gap-6">
              {[
                { label: 'ピンポン数', k: 'pings' }, { label: '対応数', k: 'res' }, { label: 'インキック', k: 'inkicks' }, { label: 'ドアキック', k: 'doorkicks' },
                { label: '対象外数', k: 'ex' }, { label: 'アプ数', k: 'up' }, { label: 'アポ数', k: 'appo' }
              ].map(f => (
                <div key={f.k}>
                  <label className="text-[10px] font-black text-slate-400 uppercase mb-2 block">{f.label}</label>
                  <input type="number" required className="w-full p-4 bg-slate-50 rounded-2xl border border-slate-100 font-black outline-none focus:ring-2 focus:ring-blue-500" value={appoForm[f.k]} onChange={e => setAppoForm({...appoForm, [f.k]: e.target.value})} />
                </div>
              ))}
            </div>
            <button disabled={loading} className="w-full bg-[#001f3f] text-white py-5 rounded-3xl font-black text-lg shadow-xl shadow-[#001f3f]/20 hover:scale-[1.02] active:scale-100 transition-all">報告を送信する</button>
          </form>
        ) : (
          <form onSubmit={submitClose} className="space-y-8">
            <div className="grid md:grid-cols-2 gap-8">
              <div>
                <label className="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2 block">商談日時</label>
                <input type="date" required className="w-full p-4 bg-slate-50 rounded-2xl border border-slate-100 font-bold outline-none" value={closeForm.date} onChange={e => setCloseForm({...closeForm, date: e.target.value})} />
              </div>
              <div>
                <label className="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2 block">顧客名 (カタカナ)</label>
                <input type="text" required className="w-full p-4 bg-slate-50 rounded-2xl border border-slate-100 font-bold outline-none" placeholder="タナカ タロウ" value={closeForm.customer} onChange={e => setCloseForm({...closeForm, customer: e.target.value})} />
              </div>
            </div>
            <div className="grid md:grid-cols-2 gap-8">
              <div>
                <label className="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2 block">アポインター</label>
                <select className="w-full p-4 bg-slate-50 rounded-2xl border border-slate-100 font-bold outline-none" value={closeForm.appointer} onChange={e => setCloseForm({...closeForm, appointer: e.target.value})}>
                  <option value="">選択...</option>
                  {staff.map(s => <option key={s.id} value={s.name}>{s.name}</option>)}
                </select>
              </div>
              <div>
                <label className="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2 block">クローザー</label>
                <select className="w-full p-4 bg-slate-50 rounded-2xl border border-slate-100 font-bold outline-none" value={closeForm.closer} onChange={e => setCloseForm({...closeForm, closer: e.target.value})}>
                  {staff.map(s => <option key={s.id} value={s.name}>{s.name}</option>)}
                </select>
              </div>
            </div>
            <div>
              <label className="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2 block">商談結果</label>
              <div className="flex gap-4">
                {['失注', '契約', '完工'].map(r => (
                  <button key={r} type="button" onClick={() => setCloseForm({...closeForm, result: r})} className={`flex-1 py-4 rounded-2xl font-black text-sm transition-all border-2 ${closeForm.result === r ? 'border-blue-600 bg-blue-50 text-blue-600' : 'border-slate-100 bg-slate-50 text-slate-400'}`}>{r}</button>
                ))}
              </div>
            </div>
            <div className="space-y-6">
              <div>
                <label className="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2 block">アポインターへのコメント (50-100文字)</label>
                <textarea className="w-full p-4 bg-slate-50 rounded-2xl border border-slate-100 font-bold outline-none h-24" placeholder="詳細を入力..." value={closeForm.appoComment} onChange={e => setCloseForm({...closeForm, appoComment: e.target.value})}></textarea>
                <p className={`text-[10px] text-right font-black ${closeForm.appoComment.length < 50 ? 'text-red-400' : 'text-green-500'}`}>{closeForm.appoComment.length} / 100</p>
              </div>
              {closeForm.closer !== user.name && (
                <div>
                  <label className="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2 block">クローザーへのコメント (50-100文字)</label>
                  <textarea className="w-full p-4 bg-slate-50 rounded-2xl border border-slate-100 font-bold outline-none h-24" placeholder="詳細を入力..." value={closeForm.closerComment} onChange={e => setCloseForm({...closeForm, closerComment: e.target.value})}></textarea>
                </div>
              )}
            </div>
            <button disabled={loading} className="w-full bg-blue-600 text-white py-5 rounded-3xl font-black text-lg shadow-xl shadow-blue-600/20 hover:scale-[1.02] active:scale-100 transition-all">商談報告を送信する</button>
          </form>
        )}
      </div>
    </div>
  );
}

function ErrorReport() {
  const [msg, setMsg] = useState('');
  const [loading, setLoading] = useState(false);

  const send = (e) => {
    e.preventDefault();
    setLoading(true);
    setTimeout(() => {
      alert('システム管理者へ報告を送信しました。');
      setMsg('');
      setLoading(false);
    }, 1000);
  };

  return (
    <div className="max-w-2xl mx-auto py-20 text-center space-y-10">
      <div className="bg-white p-10 rounded-[40px] shadow-2xl border border-slate-100">
        <div className="w-20 h-20 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-6">
          <AlertCircle className="h-10 w-10 text-red-500" />
        </div>
        <h4 className="text-2xl font-black text-[#001f3f] mb-4">システムエラー・改善要望</h4>
        <p className="text-slate-400 text-sm font-bold leading-relaxed mb-8">バグの報告や、機能改善のアイデアをお送りください。<br/>uchi2022.official@gmail.com 宛に送信されます。</p>
        <form onSubmit={send} className="space-y-6">
          <textarea required className="w-full p-6 bg-slate-50 rounded-3xl border border-slate-100 outline-none h-40 font-bold" value={msg} onChange={e => setMsg(e.target.value)} placeholder="報告内容を入力してください..."></textarea>
          <button disabled={loading} className="w-full bg-red-500 text-white py-4 rounded-2xl font-black flex items-center justify-center gap-3 shadow-lg shadow-red-500/20 hover:bg-red-600 transition-all">
            <Send className="h-5 w-5" /> 報告を送信
          </button>
        </form>
      </div>
    </div>
  );
}

function AdminHistory({ daily }) {
  const [filterDate, setFilterDate] = useState(new Date().toISOString().split('T')[0]);
  const filtered = daily.filter(d => d.date === filterDate).sort((a,b) => b.timestamp?.seconds - a.timestamp?.seconds);

  return (
    <div className="space-y-8">
      <div className="flex justify-between items-center">
        <h3 className="text-xl font-black text-[#001f3f]">アポイント報告履歴</h3>
        <input type="date" className="p-3 bg-white border rounded-2xl font-bold shadow-sm" value={filterDate} onChange={e => setFilterDate(e.target.value)} />
      </div>
      <div className="bg-white rounded-3xl shadow-sm overflow-hidden border border-slate-100">
        <table className="w-full text-left">
          <thead className="bg-slate-50 text-[10px] font-black text-slate-400 uppercase">
            <tr>
              <th className="px-8 py-4">スタッフ</th>
              <th className="px-4 py-4">ピン</th>
              <th className="px-4 py-4">対応</th>
              <th className="px-4 py-4">アポ</th>
              <th className="px-4 py-4">区分</th>
              <th className="px-4 py-4">操作</th>
            </tr>
          </thead>
          <tbody className="divide-y divide-slate-50">
            {filtered.map(d => (
              <tr key={d.id} className="hover:bg-slate-50">
                <td className="px-8 py-4 font-black">{d.appointer}</td>
                <td className="px-4 py-4 font-bold">{d.pings}</td>
                <td className="px-4 py-4 font-bold">{d.res}</td>
                <td className="px-4 py-4 font-black text-blue-600">{d.appo}</td>
                <td className="px-4 py-4 text-xs font-bold text-slate-400">{d.workType}</td>
                <td className="px-4 py-4">
                  <button className="text-blue-500 font-black text-xs hover:underline">編集</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        {filtered.length === 0 && <p className="p-20 text-center text-slate-300 font-bold">この日のデータはありません</p>}
      </div>
    </div>
  );
}

function StaffList({ staff }) {
  const [showAdd, setShowAdd] = useState(false);
  const [form, setForm] = useState({
    name: '', furigana: '', gender: '男性', birthDate: '', organization: 'SIRIUSLINK', team: '山路優チーム', position: 'アポインター', email: '', password: '', role: 'スタッフ'
  });

  const active = staff.filter(s => !s.retired).sort((a,b) => a.name.localeCompare(b.name, 'ja'));
  const retired = staff.filter(s => s.retired).sort((a,b) => a.name.localeCompare(b.name, 'ja'));

  const submit = async (e) => {
    e.preventDefault();
    try {
      await addDoc(collection(db, 'artifacts', appId, 'public', 'data', 'staff'), { ...form, retired: false });
      alert('登録しました'); setShowAdd(false);
    } catch (e) { alert('失敗'); }
  };

  return (
    <div className="space-y-10 pb-20">
      <div className="flex justify-between items-center">
        <h3 className="text-2xl font-black text-[#001f3f]">スタッフ名簿</h3>
        <button onClick={() => setShowAdd(!showAdd)} className="bg-blue-600 text-white px-6 py-3 rounded-2xl font-black flex items-center gap-2 shadow-lg shadow-blue-600/20">
          {showAdd ? <X className="h-5 w-5" /> : <UserPlus className="h-5 w-5" />} {showAdd ? '閉じる' : 'スタッフ登録'}
        </button>
      </div>

      {showAdd && (
        <form onSubmit={submit} className="bg-white p-10 rounded-[40px] shadow-2xl border border-slate-100 grid md:grid-cols-2 lg:grid-cols-3 gap-6 animate-in zoom-in-95 duration-200">
           <input className="p-4 bg-slate-50 border rounded-2xl font-bold" placeholder="氏名" required value={form.name} onChange={e => setForm({...form, name: e.target.value})} />
           <input className="p-4 bg-slate-50 border rounded-2xl font-bold" placeholder="フリガナ" required value={form.furigana} onChange={e => setForm({...form, furigana: e.target.value})} />
           <select className="p-4 bg-slate-50 border rounded-2xl font-bold" value={form.gender} onChange={e => setForm({...form, gender: e.target.value})}><option>男性</option><option>女性</option></select>
           <input className="p-4 bg-slate-50 border rounded-2xl font-bold" type="date" required value={form.birthDate} onChange={e => setForm({...form, birthDate: e.target.value})} />
           <select className="p-4 bg-slate-50 border rounded-2xl font-bold" value={form.organization} onChange={e => setForm({...form, organization: e.target.value})}>{ORGANIZATIONS.map(o => <option key={o}>{o}</option>)}</select>
           <select className="p-4 bg-slate-50 border rounded-2xl font-bold" value={form.team} onChange={e => setForm({...form, team: e.target.value})}>{TEAMS.map(t => <option key={t}>{t}</option>)}</select>
           <select className="p-4 bg-slate-50 border rounded-2xl font-bold" value={form.position} onChange={e => setForm({...form, position: e.target.value})}>{POSITIONS.map(p => <option key={p}>{p}</option>)}</select>
           <input className="p-4 bg-slate-50 border rounded-2xl font-bold" type="email" placeholder="メール" required value={form.email} onChange={e => setForm({...form, email: e.target.value})} />
           <input className="p-4 bg-slate-50 border rounded-2xl font-bold" type="password" placeholder="パスワード" required value={form.password} onChange={e => setForm({...form, password: e.target.value})} />
           <select className="p-4 bg-slate-50 border rounded-2xl font-bold" value={form.role} onChange={e => setForm({...form, role: e.target.value})}><option>スタッフ</option><option>管理者</option></select>
           <button className="md:col-span-2 lg:col-span-3 bg-[#001f3f] text-white py-5 rounded-2xl font-black text-lg">システムに登録</button>
        </form>
      )}

      <div className="bg-white rounded-3xl shadow-sm border border-slate-100 overflow-hidden">
        <table className="w-full text-left">
          <thead className="bg-slate-50 text-[10px] font-black text-slate-400 uppercase">
            <tr><th className="px-8 py-4">スタッフ</th><th className="px-4 py-4">チーム</th><th className="px-4 py-4">役職</th><th className="px-4 py-4">操作</th></tr>
          </thead>
          <tbody className="divide-y divide-slate-50">
            {active.map(s => (
              <tr key={s.id} className="hover:bg-slate-50">
                <td className="px-8 py-5">
                  <p className="font-black text-slate-800">{s.name}</p>
                  <p className="text-[10px] text-slate-400">{s.furigana}</p>
                </td>
                <td className="px-4 py-5 font-bold text-slate-500">{s.team}</td>
                <td className="px-4 py-5"><span className="px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-[10px] font-black">{s.position}</span></td>
                <td className="px-4 py-5"><button onClick={() => updateDoc(doc(db, 'artifacts', appId, 'public', 'data', 'staff', s.id), { retired: true })} className="text-red-400 font-bold text-xs">退社</button></td>
              </tr>
            ))}
            {retired.map(s => (
              <tr key={s.id} className="bg-slate-100 grayscale opacity-60">
                <td className="px-8 py-5 text-slate-400 font-bold">{s.name} (退社)</td>
                <td className="px-4 py-5 text-xs">{s.team}</td>
                <td className="px-4 py-5 text-xs">{s.position}</td>
                <td className="px-4 py-5"><button onClick={() => updateDoc(doc(db, 'artifacts', appId, 'public', 'data', 'staff', s.id), { retired: false })} className="text-blue-400 font-bold text-xs">復帰</button></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
}
