<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SIRIUSLINK.LOG | 営業管理システム</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&family=Noto+Sans+JP:wght@400;700;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', 'Noto Sans JP', sans-serif; }
        .sidebar-active { background-color: #2563eb; color: white; box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.3); }
        .animate-fade-in { animation: fadeIn 0.4s ease-out forwards; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .custom-scrollbar::-webkit-scrollbar { width: 5px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
    </style>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen">

    <!-- Auth Container -->
    <div id="auth-view" class="min-h-screen flex items-center justify-center p-4">
        <div class="bg-white p-8 md:p-10 rounded-[2.5rem] shadow-2xl w-full max-w-md border border-slate-200">
            <div class="text-center mb-10">
                <h1 class="text-4xl font-black text-blue-900 tracking-tighter mb-2 italic">SIRIUSLINK.LOG</h1>
                <p class="text-slate-500 font-bold">営業管理システム ログイン</p>
            </div>
            <div id="login-error" class="hidden mb-6 text-red-500 text-center font-bold text-sm bg-red-50 p-3 rounded-xl"></div>
            <form id="login-form" class="space-y-6">
                <div class="space-y-2">
                    <label class="text-xs font-black text-slate-400 uppercase tracking-widest px-1">ID (メールアドレス)</label>
                    <input type="email" id="email" class="w-full px-6 py-4 rounded-2xl border-2 border-slate-100 focus:border-blue-500 outline-none transition-all font-bold" value="kannrisya@gmail.com" required>
                </div>
                <div class="space-y-2">
                    <label class="text-xs font-black text-slate-400 uppercase tracking-widest px-1">パスワード</label>
                    <input type="password" id="password" class="w-full px-6 py-4 rounded-2xl border-2 border-slate-100 focus:border-blue-500 outline-none transition-all font-bold" value="kannrisya" required>
                </div>
                <button type="submit" class="w-full bg-blue-900 text-white py-5 rounded-2xl font-black shadow-xl hover:bg-blue-800 active:scale-95 transition-all text-lg tracking-widest italic">ログイン</button>
            </form>
            <div class="mt-8 pt-6 border-t border-slate-100 text-[10px] text-slate-400 text-center uppercase tracking-widest font-bold">
                デモ用: kannrisya@gmail.com / staff@gmail.com
            </div>
        </div>
    </div>

    <!-- App Container -->
    <div id="app-view" class="hidden min-h-screen flex flex-col md:flex-row">
        <!-- Sidebar -->
        <aside id="sidebar" class="fixed inset-y-0 left-0 z-[70] w-72 bg-slate-950 text-slate-100 transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out flex flex-col shadow-2xl">
            <div class="p-8">
                <h1 class="text-2xl font-black tracking-tighter text-white italic">SIRIUSLINK.LOG</h1>
            </div>
            <nav id="sidebar-nav" class="flex-1 px-4 space-y-2 overflow-y-auto custom-scrollbar">
                <!-- Nav items generated via JS -->
            </nav>
            <div class="p-6 bg-slate-900/40 mt-4 border-t border-white/5">
                <div class="flex items-center space-x-4 mb-6 px-2">
                    <img id="user-avatar" src="" class="w-12 h-12 rounded-2xl border-2 border-white/10 object-cover" alt="me">
                    <div class="overflow-hidden">
                        <p id="user-name" class="text-sm font-black truncate"></p>
                        <p id="user-role-label" class="text-[10px] text-slate-500 font-bold uppercase tracking-widest leading-none mt-1"></p>
                    </div>
                </div>
                <button id="logout-btn" class="w-full flex items-center justify-center space-x-2 px-4 py-3 bg-red-500/10 hover:bg-red-500/20 text-red-400 rounded-2xl transition-all font-bold text-xs">
                    <span>ログアウト</span>
                </button>
            </div>
        </aside>

        <!-- Sidebar Overlay (Mobile) -->
        <div id="sidebar-overlay" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-[60] md:hidden"></div>

        <!-- Content Area -->
        <main class="flex-1 md:ml-72 p-4 md:p-10 min-h-screen">
            <!-- Mobile Header -->
            <div class="md:hidden flex justify-between items-center mb-6">
                <h1 class="text-xl font-black italic tracking-tighter">SIRIUSLINK.LOG</h1>
                <button id="mobile-menu-btn" class="p-2 bg-white rounded-xl shadow-sm border border-slate-200 text-slate-900 font-bold">MENU</button>
            </div>

            <!-- Desktop Header -->
            <header class="hidden md:flex justify-between items-center mb-10 bg-white p-6 rounded-[2rem] shadow-sm border border-slate-100">
                <h2 id="view-title" class="text-2xl font-black text-slate-800 italic">タイムライン</h2>
                <div class="flex items-center space-x-6 text-right">
                    <div>
                        <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest leading-none mb-1">Signed in as</p>
                        <p id="header-user-name" class="text-sm font-black text-blue-900 leading-none"></p>
                    </div>
                    <div class="w-12 h-12 bg-slate-50 rounded-2xl flex items-center justify-center text-slate-400 relative">
                        <span class="absolute top-3 right-3 w-2 h-2 bg-red-500 rounded-full border-2 border-white"></span>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
                    </div>
                </div>
            </header>

            <div id="main-content" class="max-w-6xl mx-auto animate-fade-in">
                <!-- Content generated via JS -->
            </div>
        </main>
    </div>

    <!-- Custom Toast -->
    <div id="toast" class="hidden fixed top-6 right-6 z-[100] transform transition-transform duration-300">
        <div id="toast-body" class="px-6 py-4 rounded-2xl shadow-2xl border flex items-center space-x-3 bg-blue-900 border-blue-800 text-white">
            <span id="toast-message" class="font-bold"></span>
        </div>
    </div>

    <script>
        // --- Core State ---
        let currentUser = null;
        let activeTab = 'timeline';

        const users = [
            { id: 'u1', email: 'kannrisya@gmail.com', password: 'kannrisya', name: '内田 健太', furigana: 'ウチダ ケンタ', role: 'admin', gender: '男性', birthday: '1988-04-12', joinDate: '2021-01-01', organization: 'SIRIUSLINK', team: '山路優チーム', position: 'クローザー', bio: '全速前進！', image: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=150&h=150&fit=crop', active: true },
            { id: 'u2', email: 'staff@gmail.com', password: 'staff', name: '田中 太郎', furigana: 'タナカ タロウ', role: 'staff', gender: '男性', birthday: '1995-08-20', joinDate: '2023-05-15', organization: '西河はるや', team: '磯和美優チーム', position: 'アポインター', bio: '一意専心。', image: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=150&h=150&fit=crop', active: true }
        ];

        const reports = [
            { id: 'r1', type: 'appoint', userId: 'u2', userName: '田中 太郎', date: '2023-11-01', mode: '通常対応', pingpong: 120, response: 60, inKick: 15, doorKick: 8, outOfScope: 5, approach: 20, apo: 4 },
            { id: 'r2', type: 'closing', date: '2023-11-02', appointUserId: 'u2', appointUserName: '田中 太郎', closerUserId: 'u1', closerUserName: '内田 健太', commentWriterId: 'u1', commentWriterName: '内田 健太', clientName: 'サトウ', status: '完工', commentToApo: '非常に丁寧なヒアリングがされており、現場での話がスムーズでした。お客様も大変満足されています。', commentToCloser: '迅速なクロージングでした。', timestamp: new Date().toISOString() }
        ];

        // --- Helpers ---
        const getAge = (bday) => {
            const birthDate = new Date(bday);
            const today = new Date();
            let age = today.getFullYear() - birthDate.getFullYear();
            const m = today.getMonth() - birthDate.getMonth();
            if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) age--;
            return age;
        };

        const getActivityPeriod = (joinDate) => {
            const start = new Date(joinDate);
            const end = new Date();
            let years = end.getFullYear() - start.getFullYear();
            let months = end.getMonth() - start.getMonth() + 1;
            if (months <= 0) { years--; months += 12; }
            return years > 0 ? `${years}年${months}ヶ月目` : `${months}ヶ月目`;
        };

        const formatPercent = (val) => isNaN(val) || !isFinite(val) ? '0%' : `${Math.round(val)}%`;

        const showToast = (msg, type = 'success') => {
            const toast = document.getElementById('toast');
            const body = document.getElementById('toast-body');
            document.getElementById('toast-message').textContent = msg;
            body.className = `px-6 py-4 rounded-2xl shadow-2xl border flex items-center space-x-3 ${type === 'success' ? 'bg-blue-900 border-blue-800' : 'bg-red-600 border-red-500'} text-white`;
            toast.classList.remove('hidden');
            setTimeout(() => toast.classList.add('hidden'), 3000);
        };

        // --- Auth Functions ---
        const handleLogin = (e) => {
            e.preventDefault();
            const email = document.getElementById('email').value;
            const pass = document.getElementById('password').value;
            const user = users.find(u => u.email === email && u.password === pass);
            
            if (user) {
                currentUser = user;
                document.getElementById('auth-view').classList.add('hidden');
                document.getElementById('app-view').classList.remove('hidden');
                initApp();
            } else {
                const err = document.getElementById('login-error');
                err.textContent = "IDまたはパスワードが間違っています。";
                err.classList.remove('hidden');
            }
        };

        const handleLogout = () => {
            currentUser = null;
            document.getElementById('app-view').classList.add('hidden');
            document.getElementById('auth-view').classList.remove('hidden');
            document.getElementById('login-form').reset();
            document.getElementById('login-error').classList.add('hidden');
        };

        // --- View Rendering ---
        const initApp = () => {
            document.getElementById('user-avatar').src = currentUser.image;
            document.getElementById('user-name').textContent = currentUser.name;
            document.getElementById('header-user-name').textContent = currentUser.name;
            document.getElementById('user-role-label').textContent = currentUser.role === 'admin' ? '管理者' : 'スタッフ';
            renderSidebar();
            renderContent();
        };

        const renderSidebar = () => {
            const nav = document.getElementById('sidebar-nav');
            const items = [
                { id: 'timeline', label: 'タイムライン', adminOnly: false },
                { id: 'overall', label: '全体営業成績', adminOnly: false },
                { id: 'ranking', label: '営業成績ランキング', adminOnly: false },
                { id: 'profile', label: '個人プロフィール', adminOnly: false },
                { id: 'report', label: '日報・商談報告', adminOnly: false },
                { id: 'error', label: 'システムエラー報告', adminOnly: false },
                { id: 'history', label: '履歴', adminOnly: true },
                { id: 'staff', label: 'スタッフ名簿', adminOnly: true }
            ];

            nav.innerHTML = items.map(item => {
                if (item.adminOnly && currentUser.role !== 'admin') return '';
                const isActive = activeTab === item.id;
                return `
                    <button onclick="switchTab('${item.id}')" class="w-full flex items-center space-x-3 px-5 py-4 rounded-2xl transition-all duration-200 ${isActive ? 'sidebar-active' : 'text-slate-400 hover:bg-slate-800 hover:text-white'}">
                        <span class="font-black text-sm">${item.label}</span>
                    </button>
                `;
            }).join('');
        };

        const switchTab = (tabId) => {
            activeTab = tabId;
            document.getElementById('sidebar-overlay').classList.add('hidden');
            document.getElementById('sidebar').classList.add('-translate-x-full');
            document.getElementById('sidebar').classList.remove('translate-x-0');
            renderSidebar();
            renderContent();
            
            const titles = {
                timeline: 'タイムライン', overall: '全体営業成績', ranking: '営業成績ランキング',
                profile: '個人プロフィール', report: '日報・商談報告', error: 'システムエラー報告',
                history: '履歴 (管理者用)', staff: 'スタッフ名簿'
            };
            document.getElementById('view-title').textContent = titles[tabId];
        };

        const renderContent = () => {
            const container = document.getElementById('main-content');
            container.innerHTML = '';

            switch (activeTab) {
                case 'timeline': renderTimeline(container); break;
                case 'overall': renderOverall(container); break;
                case 'ranking': renderRanking(container); break;
                case 'profile': renderProfile(container); break;
                case 'report': renderReport(container); break;
                case 'error': renderErrorView(container); break;
                case 'history': renderHistory(container); break;
                case 'staff': renderStaffList(container); break;
            }
        };

        const renderTimeline = (container) => {
            const events = reports
                .filter(r => r.type === 'closing' && (r.status === '契約' || r.status === '完工'))
                .sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp))
                .slice(0, 10);

            container.innerHTML = `
                <div class="bg-white p-8 rounded-[2.5rem] shadow-sm border border-slate-100">
                    <h3 class="text-xl font-black text-slate-800 mb-10 flex items-center italic">最新の成約タイムライン</h3>
                    <div class="space-y-8">
                        ${events.length === 0 ? '<p class="text-slate-400 text-center py-12">現在成約情報はありません</p>' : events.map(ev => `
                            <div class="relative pl-8 border-l-4 border-blue-500 py-2">
                                <div class="absolute -left-3 top-0 w-5 h-5 bg-blue-500 rounded-full border-4 border-white shadow-md"></div>
                                <div class="bg-slate-50 p-6 rounded-[2rem] border border-slate-100 hover:shadow-lg transition-shadow">
                                    <p class="text-blue-700 font-black text-lg mb-4">🎉 ご契約おめでとうございます！</p>
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm mb-6">
                                        <div><p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">契約日時</p><p class="font-bold">${new Date(ev.timestamp).toLocaleString()}</p></div>
                                        <div><p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">顧客名</p><p class="font-bold">${ev.clientName}様案件</p></div>
                                        <div><p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">アポインター</p><p class="font-bold">${ev.appointUserName}</p></div>
                                        <div><p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">クローザー</p><p class="font-bold">${ev.closerUserName}</p></div>
                                    </div>
                                    <div class="space-y-4 pt-4 border-t border-slate-200 italic">
                                        <div class="bg-white p-4 rounded-2xl border border-slate-100">
                                            <p class="text-[10px] font-black text-blue-600 not-italic mb-1">${ev.commentWriterName}から${ev.appointUserName}さんへのコメント：</p>
                                            <p class="text-sm text-slate-600">「${ev.commentToApo}」</p>
                                        </div>
                                        ${ev.commentToCloser ? `
                                        <div class="bg-white p-4 rounded-2xl border border-slate-100">
                                            <p class="text-[10px] font-black text-indigo-600 not-italic mb-1">${ev.commentWriterName}から${ev.closerUserName}さんへのコメント：</p>
                                            <p class="text-sm text-slate-600">「${ev.commentToCloser}」</p>
                                        </div>` : ''}
                                    </div>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                </div>
            `;
        };

        const renderOverall = (container) => {
            const stats = calculateStats();
            container.innerHTML = `
                <div class="space-y-8">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="bg-blue-950 text-white p-10 rounded-[2.5rem] shadow-2xl relative overflow-hidden flex flex-col justify-center">
                           <div class="flex justify-between items-center mb-8 relative z-10">
                              <div><p class="text-blue-300 text-[10px] font-black uppercase tracking-widest mb-1">Total Sales</p><p class="text-5xl font-black">${stats.totalSales}<span class="text-lg ml-1 opacity-50">万</span></p></div>
                              <div class="text-right"><p class="text-blue-300 text-[10px] font-black uppercase tracking-widest mb-1">Completed</p><p class="text-5xl font-black">${stats.totalCompletion}<span class="text-lg ml-1 opacity-50">件</span></p></div>
                           </div>
                           <div class="h-1 bg-white/10 rounded-full overflow-hidden relative z-10"><div class="w-[75%] h-full bg-blue-500"></div></div>
                        </div>
                        <div class="grid grid-cols-2 gap-6">
                            <div class="bg-white p-8 rounded-[2rem] shadow-sm border border-slate-100 flex flex-col justify-center items-center text-center">
                                <p class="text-slate-400 text-[10px] font-black uppercase tracking-widest mb-2">完工率</p>
                                <p class="text-4xl font-black text-blue-600">${formatPercent((stats.totalCompletion / stats.totalPingPong) * 100)}</p>
                            </div>
                            <div class="bg-white p-8 rounded-[2rem] shadow-sm border border-slate-100 flex flex-col justify-center items-center text-center">
                                <p class="text-slate-400 text-[10px] font-black uppercase tracking-widest mb-2">平均PP</p>
                                <p class="text-4xl font-black text-blue-600">${Math.round(stats.totalPingPong / (stats.totalAttendance || 1))}<span class="text-sm font-bold ml-1">件/日</span></p>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-4">
                        ${[
                            { label: '出勤数', val: stats.totalAttendance, unit: '日' },
                            { label: 'PP数', val: stats.totalPingPong, unit: '回' },
                            { label: 'アポ数', val: stats.totalApo, unit: '件' },
                            { label: '商談数', val: stats.totalNegotiation, unit: '件' },
                            { label: '契約数', val: stats.totalContracts, unit: '件' },
                            { label: '対応数', val: stats.totalResponse, unit: '件' },
                            { label: '対象外', val: stats.totalOutOfScope, unit: '件' }
                        ].map(item => `
                            <div class="bg-white p-5 rounded-3xl border border-slate-100 shadow-sm text-center">
                                <p class="text-[9px] text-slate-400 font-black uppercase tracking-widest mb-2">${item.label}</p>
                                <p class="text-xl font-black text-slate-800">${item.val}<span class="text-[10px] opacity-40 ml-0.5">${item.unit}</span></p>
                            </div>
                        `).join('')}
                    </div>

                    <div class="bg-white rounded-[2.5rem] shadow-sm border border-slate-100 overflow-hidden">
                        <div class="p-8 border-b border-slate-50"><h4 class="font-black text-slate-800 text-lg italic">スタッフ別成績一覧</h4></div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left">
                                <thead class="bg-slate-50 text-slate-400 font-black uppercase text-[10px] tracking-widest">
                                    <tr><th class="px-10 py-6">氏名</th><th class="px-4 py-6">出勤</th><th class="px-4 py-6">PP数</th><th class="px-4 py-6">アポ数</th><th class="px-4 py-6 text-blue-600">アポ完工</th></tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    ${users.map(u => {
                                        const s = stats.staffStats[u.id] || { attendance: 0, pingpong: 0, apo: 0, apoCompletion: 0 };
                                        return `
                                            <tr class="hover:bg-slate-50 transition-colors cursor-pointer" onclick="switchTab('profile')">
                                                <td class="px-10 py-6"><div class="flex items-center space-x-4"><img src="${u.image}" class="w-10 h-10 rounded-xl object-cover shadow-sm"><span class="font-black text-slate-800">${u.name}</span></div></td>
                                                <td class="px-4 py-6 font-bold text-slate-500">${s.attendance}日</td>
                                                <td class="px-4 py-6 font-bold text-slate-500">${s.pingpong.toLocaleString()}</td>
                                                <td class="px-4 py-6 font-black text-slate-800">${s.apo}件</td>
                                                <td class="px-4 py-6 font-black text-blue-600">${s.apoCompletion}件</td>
                                            </tr>
                                        `;
                                    }).join('')}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            `;
        };

        const renderRanking = (container) => {
            container.innerHTML = `
                <div class="bg-white p-10 rounded-[3rem] shadow-sm border border-slate-100">
                    <h3 class="text-2xl font-black text-slate-800 mb-10 italic">営業成績ランキング</h3>
                    <div class="space-y-4">
                        ${users.sort((a,b) => b.id.localeCompare(a.id)).map((u, i) => `
                            <div class="flex items-center p-6 bg-white rounded-3xl border border-slate-50 hover:shadow-lg transition-all">
                                <div class="w-12 h-12 flex items-center justify-center font-black rounded-2xl mr-6 bg-slate-100 text-slate-300 ${i===0?'bg-yellow-400 text-white':''}">${i+1}</div>
                                <img src="${u.image}" class="w-14 h-14 rounded-3xl mr-6 object-cover shadow-md">
                                <div class="flex-1"><p class="font-black text-lg">${u.name}</p><p class="text-[10px] text-slate-400 font-black uppercase tracking-widest">${u.team}</p></div>
                                <div class="text-right font-black text-3xl text-blue-900">${Math.floor(Math.random()*10)}<span class="text-sm ml-1 text-slate-400">件</span></div>
                            </div>
                        `).join('')}
                    </div>
                </div>
            `;
        };

        const renderProfile = (container) => {
            container.innerHTML = `
                <div class="space-y-8">
                    <div class="bg-white p-10 rounded-[3rem] shadow-sm border border-slate-100 relative overflow-hidden">
                        <div class="flex flex-col md:flex-row items-center md:items-start space-y-8 md:space-y-0 md:space-x-12 relative z-10">
                            <img src="${currentUser.image}" class="w-48 h-48 rounded-[3rem] object-cover shadow-2xl border-4 border-white">
                            <div class="flex-1">
                                <div class="mb-8"><span class="text-slate-400 text-xs font-black tracking-widest uppercase italic">${currentUser.furigana}</span><h3 class="text-4xl font-black text-slate-800 tracking-tight mt-1">${currentUser.name}</h3></div>
                                <div class="grid grid-cols-2 lg:grid-cols-3 gap-y-8 gap-x-12 mb-10 max-w-3xl">
                                    <div><p class="text-[10px] text-slate-400 font-black mb-1">活動期間</p><p class="font-black">${getActivityPeriod(currentUser.joinDate)}</p></div>
                                    <div><p class="text-[10px] text-slate-400 font-black mb-1">年齢</p><p class="font-black">${getAge(currentUser.birthday)}歳</p></div>
                                    <div><p class="text-[10px] text-slate-400 font-black mb-1">所属</p><p class="font-black">${currentUser.organization}</p></div>
                                    <div><p class="text-[10px] text-slate-400 font-black mb-1">チーム</p><p class="font-black">${currentUser.team}</p></div>
                                    <div><p class="text-[10px] text-slate-400 font-black mb-1">役職</p><p class="font-black">${currentUser.position}</p></div>
                                </div>
                                <div class="max-w-md">
                                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-2 px-1">一言</label>
                                    <input value="${currentUser.bio}" class="w-full bg-slate-50 border-2 border-slate-100 p-4 rounded-2xl font-bold outline-none focus:border-blue-500">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        };

        const renderReport = (container) => {
            const isAdmin = currentUser.role === 'admin';
            container.innerHTML = `
                <div class="bg-white rounded-[3rem] shadow-sm border border-slate-100 overflow-hidden">
                    <div class="flex bg-slate-50 border-b border-slate-50 p-2">
                        <button onclick="switchReportType('appoint')" id="tab-appo" class="flex-1 py-5 rounded-[2rem] font-black text-sm uppercase tracking-widest bg-blue-900 text-white shadow-xl">アポイント報告</button>
                        ${isAdmin ? `<button onclick="switchReportType('closing')" id="tab-clo" class="flex-1 py-5 rounded-[2rem] font-black text-sm uppercase tracking-widest text-slate-400">クロージング報告</button>` : ''}
                    </div>
                    <div id="report-form-container" class="p-10 md:p-14 animate-fade-in">
                        ${renderAppoForm()}
                    </div>
                </div>
            `;
        };

        const renderAppoForm = () => `
            <form onsubmit="event.preventDefault(); showToast('アポイント日報を送信しました');" class="space-y-10">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
                    <div class="space-y-2"><label class="text-[10px] font-black text-slate-400 uppercase tracking-widest px-1">日付</label><input type="date" class="w-full bg-slate-50 p-5 rounded-2xl border-2 border-slate-50 font-bold" value="${new Date().toISOString().split('T')[0]}"></div>
                    <div class="space-y-2"><label class="text-[10px] font-black text-slate-400 uppercase tracking-widest px-1">対応タイプ</label><select class="w-full bg-slate-50 p-5 rounded-2xl border-2 border-slate-50 font-bold"><option>通常対応</option><option>平日対応</option></select></div>
                    <div class="space-y-2"><label class="text-[10px] font-black text-slate-400 uppercase tracking-widest px-1">PP数</label><input type="number" class="w-full bg-slate-50 p-5 rounded-2xl border-2 border-slate-50 font-bold"></div>
                    <div class="space-y-2"><label class="text-[10px] font-black text-slate-400 uppercase tracking-widest px-1">対応数</label><input type="number" class="w-full bg-slate-50 p-5 rounded-2xl border-2 border-slate-50 font-bold"></div>
                    <div class="space-y-2"><label class="text-[10px] font-black text-slate-400 uppercase tracking-widest px-1">アポ数</label><input type="number" class="w-full bg-slate-50 p-5 rounded-2xl border-2 border-slate-50 font-bold"></div>
                </div>
                <button type="submit" class="w-full py-5 bg-blue-900 text-white rounded-[2rem] font-black shadow-2xl hover:bg-blue-800 transition-all text-xl italic tracking-widest">報告を送信する</button>
            </form>
        `;

        const renderCloForm = () => `
            <form onsubmit="event.preventDefault(); showToast('商談報告を送信しました');" class="space-y-10 animate-fade-in">
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                    <div class="space-y-2"><label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">商談日付</label><input type="date" class="w-full bg-slate-50 p-5 rounded-2xl border-2 border-slate-50 font-bold" value="${new Date().toISOString().split('T')[0]}"></div>
                    <div class="space-y-2"><label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">顧客名</label><input class="w-full bg-slate-50 p-5 rounded-2xl border-2 border-slate-50 font-bold" placeholder="ヤマダ タロウ"></div>
                    <div class="space-y-2"><label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">アポインター</label><select class="w-full bg-slate-50 p-5 rounded-2xl border-2 border-slate-50 font-bold">${users.map(u=>`<option>${u.name}</option>`).join('')}</select></div>
                    <div class="space-y-2"><label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">クローザー</label><select class="w-full bg-slate-50 p-5 rounded-2xl border-2 border-slate-50 font-bold">${users.map(u=>`<option ${u.name===currentUser.name?'selected':''}>${u.name}</option>`).join('')}</select></div>
                </div>
                <div class="space-y-2"><label class="text-[10px] font-black text-slate-400 uppercase tracking-widest">商談結果</label><div class="flex gap-4">${['失注', '契約', '完工'].map(res => `<button type="button" class="flex-1 py-4 rounded-2xl font-black ${res==='完工'?'bg-blue-600 text-white shadow-lg':'bg-slate-50 text-slate-400'}">${res}</button>`).join('')}</div></div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                    <div class="space-y-2"><label class="text-[10px] font-black text-slate-400 uppercase tracking-widest italic">アポインターへのコメント (50-100字)</label><textarea class="w-full bg-slate-50 p-6 rounded-[2rem] border-2 border-slate-50 h-32 outline-none font-medium leading-relaxed"></textarea></div>
                    <div class="space-y-2"><label class="text-[10px] font-black text-slate-400 uppercase tracking-widest italic">クローザーへのコメント (任意)</label><textarea class="w-full bg-slate-50 p-6 rounded-[2rem] border-2 border-slate-50 h-32 outline-none font-medium leading-relaxed"></textarea></div>
                </div>
                <button type="submit" class="w-full py-5 bg-blue-900 text-white rounded-[2.5rem] font-black shadow-2xl hover:bg-blue-800 text-xl tracking-widest italic">商談報告を送信</button>
            </form>
        `;

        window.switchReportType = (type) => {
            const container = document.getElementById('report-form-container');
            const tabAppo = document.getElementById('tab-appo');
            const tabClo = document.getElementById('tab-clo');
            
            if (type === 'appoint') {
                container.innerHTML = renderAppoForm();
                tabAppo.className = "flex-1 py-5 rounded-[2rem] font-black text-sm uppercase tracking-widest bg-blue-900 text-white shadow-xl";
                tabClo.className = "flex-1 py-5 rounded-[2rem] font-black text-sm uppercase tracking-widest text-slate-400";
            } else {
                container.innerHTML = renderCloForm();
                tabClo.className = "flex-1 py-5 rounded-[2rem] font-black text-sm uppercase tracking-widest bg-blue-900 text-white shadow-xl";
                tabAppo.className = "flex-1 py-5 rounded-[2rem] font-black text-sm uppercase tracking-widest text-slate-400";
            }
        };

        const renderErrorView = (container) => {
            container.innerHTML = `
                <div class="max-w-3xl mx-auto py-10">
                    <div class="bg-white p-12 rounded-[3rem] shadow-sm border border-slate-100 text-center relative overflow-hidden">
                        <div class="w-20 h-20 bg-red-50 text-red-600 rounded-[2rem] flex items-center justify-center mx-auto mb-10">⚠️</div>
                        <h3 class="text-3xl font-black text-slate-800 mb-4 tracking-tight italic">システムエラー報告・改善要望</h3>
                        <p class="text-slate-400 font-bold mb-10 leading-relaxed max-w-lg mx-auto uppercase text-xs tracking-widest">バグや改善アイデアがあれば送付してください。</p>
                        <textarea id="error-msg" class="w-full bg-slate-50 p-8 rounded-[2.5rem] border-2 border-slate-100 h-56 outline-none focus:border-red-400 shadow-inner font-medium" placeholder="具体的な内容を記入してください..."></textarea>
                        <button onclick="if(document.getElementById('error-msg').value){showToast('バグ報告を受理しました'); document.getElementById('error-msg').value='';}" class="w-full mt-8 py-5 bg-slate-900 text-white rounded-[2rem] font-black shadow-2xl hover:bg-slate-800 text-lg tracking-widest italic">報告を送信</button>
                    </div>
                </div>
            `;
        };

        const renderHistory = (container) => {
            container.innerHTML = `
                <div class="bg-white rounded-[2.5rem] shadow-sm border border-slate-100 overflow-hidden">
                    <div class="p-10 border-b border-slate-50 flex justify-between items-center">
                        <h4 class="font-black text-slate-800 text-2xl italic tracking-tight">全スタッフ報告履歴</h4>
                        <input type="month" class="bg-slate-50 border border-slate-100 rounded-2xl px-6 py-3 font-bold text-blue-900" value="2023-11">
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left">
                            <thead class="bg-slate-50 text-slate-400 font-black uppercase text-[10px] tracking-widest">
                                <tr><th class="px-10 py-6">日時</th><th class="px-6 py-6">氏名</th><th class="px-6 py-6 text-center">種別</th><th class="px-6 py-6 text-center">アポ</th><th class="px-10 py-6 text-right">管理操作</th></tr>
                            </thead>
                            <tbody class="divide-y divide-slate-50">
                                ${reports.map(r => `
                                    <tr class="hover:bg-slate-50 transition-colors">
                                        <td class="px-10 py-6 font-bold text-slate-400 text-sm">${r.date}</td>
                                        <td class="px-6 py-6 font-black text-slate-700">${r.userName || r.appointUserName}</td>
                                        <td class="px-6 py-6 text-center italic font-bold text-xs text-slate-400 uppercase">${r.type==='appoint'?'日報':'商談'}</td>
                                        <td class="px-6 py-6 text-center font-black text-blue-900">${r.apo||'-'}</td>
                                        <td class="px-10 py-6 text-right"><button class="text-[10px] font-black text-blue-600 uppercase tracking-widest">Edit</button></td>
                                    </tr>
                                `).join('')}
                            </tbody>
                        </table>
                    </div>
                </div>
            `;
        };

        const renderStaffList = (container) => {
            container.innerHTML = `
                <div class="space-y-10">
                    <div class="flex justify-between items-center">
                        <h3 class="text-3xl font-black text-slate-800 italic">スタッフ名簿</h3>
                        <button class="bg-blue-950 text-white px-8 py-4 rounded-2xl font-black shadow-2xl hover:scale-105 transition-all">スタッフ登録</button>
                    </div>
                    <div class="bg-white rounded-[3rem] shadow-sm border border-slate-100 overflow-hidden">
                        <div class="p-8 border-b border-slate-50 flex items-center space-x-6 text-slate-300">
                            <span>🔍</span><input class="flex-1 bg-transparent outline-none font-bold text-slate-700" placeholder="名前、所属、チームで検索...">
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left">
                                <thead class="bg-slate-50 text-slate-400 font-black uppercase text-[10px] tracking-widest">
                                    <tr><th class="px-10 py-6">氏名</th><th class="px-6 py-6">期間/年齢</th><th class="px-6 py-6">チーム</th><th class="px-6 py-6">権限</th><th class="px-10 py-6 text-right">詳細</th></tr>
                                </thead>
                                <tbody class="divide-y divide-slate-50">
                                    ${users.map(u => `
                                        <tr class="hover:bg-slate-50">
                                            <td class="px-10 py-7"><div class="flex items-center space-x-4"><img src="${u.image}" class="w-14 h-14 rounded-2xl object-cover shadow-sm border-2 border-white"><div><p class="font-black text-slate-800 text-lg mb-1 leading-none">${u.name}</p><p class="text-[9px] text-slate-400 font-black uppercase">${u.email}</p></div></div></td>
                                            <td class="px-6 py-7"><p class="font-black text-slate-700 text-sm">${getActivityPeriod(u.joinDate)}</p><p class="text-[10px] text-slate-400 font-bold">${getAge(u.birthday)}歳</p></td>
                                            <td class="px-6 py-7"><p class="font-bold text-slate-700 text-sm">${u.team}</p><p class="text-[10px] text-slate-400 font-black uppercase italic">${u.position}</p></td>
                                            <td class="px-6 py-7"><span class="px-4 py-1.5 rounded-full text-[9px] font-black uppercase tracking-widest border ${u.role==='admin'?'bg-indigo-50 text-indigo-700 border-indigo-100':'bg-blue-50 text-blue-700 border-blue-100'}">${u.role}</span></td>
                                            <td class="px-10 py-7 text-right"><button class="text-[10px] font-black text-blue-600 uppercase">Modify</button></td>
                                        </tr>
                                    `).join('')}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            `;
        };

        const calculateStats = () => {
            const stats = {
                totalSales: 2450, totalCompletion: 0, totalApo: 0, totalPingPong: 0,
                totalResponse: 0, totalInKick: 0, totalDoorKick: 0, totalOutOfScope: 0,
                totalApproach: 0, totalAttendance: 0, totalNegotiation: 0, totalContracts: 0,
                staffStats: {}
            };

            reports.forEach(r => {
                if (r.type === 'appoint') {
                    stats.totalPingPong += r.pingpong;
                    stats.totalResponse += r.response;
                    stats.totalApo += r.apo;
                    stats.totalAttendance += (r.mode === '平日対応' ? 0.3 : 1.0);

                    if (!stats.staffStats[r.userId]) stats.staffStats[r.userId] = { name: r.userName, apo: 0, pingpong: 0, completion: 0, attendance: 0 };
                    stats.staffStats[r.userId].apo += r.apo;
                    stats.staffStats[r.userId].pingpong += r.pingpong;
                    stats.staffStats[r.userId].attendance += (r.mode === '平日対応' ? 0.3 : 1.0);
                } else if (r.type === 'closing') {
                    stats.totalNegotiation += 1;
                    if (r.status === '契約' || r.status === '完工') stats.totalContracts += 1;
                    if (r.status === '完工') {
                        stats.totalCompletion += 1;
                        if (stats.staffStats[r.appointUserId]) stats.staffStats[r.appointUserId].completion += 1;
                    }
                }
            });
            return stats;
        };

        // --- Event Listeners ---
        document.getElementById('login-form').addEventListener('submit', handleLogin);
        document.getElementById('logout-btn').addEventListener('click', handleLogout);
        document.getElementById('mobile-menu-btn').addEventListener('click', () => {
            document.getElementById('sidebar').classList.remove('-translate-x-full');
            document.getElementById('sidebar').classList.add('translate-x-0');
            document.getElementById('sidebar-overlay').classList.remove('hidden');
        });
        document.getElementById('sidebar-overlay').addEventListener('click', () => {
            document.getElementById('sidebar').classList.add('-translate-x-full');
            document.getElementById('sidebar').classList.remove('translate-x-0');
            document.getElementById('sidebar-overlay').classList.add('hidden');
        });

    </script>
</body>
</html>
